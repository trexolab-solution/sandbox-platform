# Admin seed (used once by /api/internal/seed-admin to create the first admin)
# No default: an unset value makes seeding refuse rather than create a known login.
ADMIN_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=

# Database
DB_FILE_NAME=file:database.db

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=https://sandbox.trexolab.com

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Docker
DOCKER_SOCKET_PATH=/var/run/docker.sock

# WebSocket Server
WS_PORT=3001
INTERNAL_API_URL=http://localhost:1362

# Logging Configuration
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
# Enable pretty printing for development (set to false in production)
LOG_PRETTY=true

# Node Environment
NODE_ENV=development

# Telegram Bot Integration (for admin notifications)
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Chat ID for admin notifications (can be user ID, group ID, or channel ID)
# To get your chat ID, message @userinfobot on Telegram
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id
# Optional: Webhook secret for verifying webhook requests
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
