{
  "name": "sandbox",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n \"next,ws\" -c \"cyan,magenta\" \"next dev -p 1362\" \"cd server && tsx watch --env-file=../.env ws-terminal.ts\"",
    "build": "next build",
    "start": "concurrently -n \"next,ws\" -c \"cyan,magenta\" \"next start -p 1362\" \"cd server && tsx --env-file=../.env ws-terminal.ts\"",
    "start:next": "next start -p 1362",
    "start:ws": "cd server && tsx --env-file=../.env ws-terminal.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --port 1360",
    "db:push": "drizzle-kit push",
    "auth:generate": "npx @better-auth/cli@latest generate --config lib/auth.ts --output ./database/schemas/auth-schema.ts --yes",
    "lint": "eslint"
  },
